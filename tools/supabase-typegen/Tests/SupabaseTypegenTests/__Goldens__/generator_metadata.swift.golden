import Foundation
import PostgrestMacros

enum UserStatus: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case online = "ONLINE"
  case offline = "OFFLINE"
}

@Table("channels")
struct Channels {
  @PrimaryKey @Default var id: Int
  var slug: String
}

extension Channels.Columns {
  var channelMessages: _PostgrestToManyRelation<Channels, Messages> {
    .init("channel_messages")
  }
  var firstMessage: _PostgrestToOneRelation<Channels, Messages> {
    .init("first_message")
  }
  var shoutedSlug: _PostgrestComputedField<Channels, String> {
    .init("shouted_slug")
  }
}

@Table("counters")
struct Counters {
  @PrimaryKey @Generated var id: Int
  var count: Int
  @Generated var doubled: Int?
}

@Table("discussions")
struct Discussions {
  @PrimaryKey @Default var id: Int
  var title: String
  var pinnedPostId: Int?
}

@Table("key_value_storage")
struct KeyValueStorage {
  @PrimaryKey var key: String
  var value: JSONValue?
}

@Table("messages")
struct Messages {
  @PrimaryKey @Default var id: Int
  var channelId: Int?
  var data: JSONValue?
  var message: String?
  var username: String?
}

@Table("note_summaries")
struct NoteSummaries {
  var id: Int?
  var body: String?
  var bodyLength: Int?
}

@Table("notes")
struct Notes {
  @PrimaryKey @Default var id: Int
  var body: String
}

@Table("postgres_values")
struct PostgresValues {
  @PrimaryKey @Generated var id: Int
  var intSpan: _PostgresRange<Int>?
  var bigSpan: _PostgresRange<Int>?
  var numSpan: _PostgresRange<Decimal>?
  var localSpan: _PostgresRange<Date>?
  var instantSpan: _PostgresRange<Date>?
  var daySpan: _PostgresRange<Date>?
  var duration: _PostgresInterval?
  var atTime: _PostgresTime?
  var atTimeTz: _PostgresTime?
  var payload: _PostgresBytes?
  var address: String?
  var network: String?
  var mac: String?
  var price: String?
  var document: String?
  var pair: _PostgresUnmapped?
  var spot: _PostgresUnmapped?
}

@Table("posts")
struct Posts {
  @PrimaryKey @Default var id: Int
  var discussionId: Int
  var author: String
  @Default var approved: Bool
  @Default var createdAt: Date
}

@Table("replies")
struct Replies {
  @PrimaryKey @Default var id: Int
  var postId: Int
  var body: String
  @Default var approved: Bool
}

@Table("temporal_values")
struct TemporalValues {
  @PrimaryKey @Generated var id: Int
  var atInstant: Date
  var atLocal: Date
  var onDay: Date
}

@Table("todos")
struct Todos {
  @PrimaryKey @Default var id: UUID
  var description: String
  @Default var isComplete: Bool
  @Default var tags: [String]?
  @Default var createdAt: Date?
}

@Table("updatable_view")
struct UpdatableView {
  var username: String?
  var nonUpdatableColumn: Int?
}

@Table("users")
struct Users {
  @PrimaryKey @Default var id: UUID
  var email: String?
  var username: String?
  var ageRange: _PostgresRange<Int>?
  var catchphrase: String?
  var data: JSONValue?
  @Default var status: UserStatus?
}

@Table("channel_message_counts", readOnly: true)
struct ChannelMessageCountsRow {
  var channelId: Int?
  var messageCount: Int?
  var slug: String?
}

@Table("get_username_and_status", readOnly: true)
struct GetUsernameAndStatusRow {
  var status: UserStatus?
  var username: String?
}

extension _PostgrestRpc {
  func channelMessageCounts(minMessages: Int? = nil) throws -> _PostgrestQuery<
    ChannelMessageCountsRow, [ChannelMessageCountsRow]
  > {
    try self.rows("channel_message_counts", arguments: ["min_messages": minMessages])
  }

  func deleteUser() throws -> _PostgrestFunctionCall<Void> {
    try self.perform("delete_user")
  }

  func echo(_ body: JSONValue) throws -> _PostgrestFunctionCall<JSONValue?> {
    try self.value("echo", arguments: _PostgrestArguments(body))
  }

  func getArrayElement(arr: [Int], index: Int) throws -> _PostgrestFunctionCall<Int?> {
    try self.value("get_array_element", arguments: ["arr": arr, "index": index])
  }

  func getStatus(nameParam: String) throws -> _PostgrestFunctionCall<String?> {
    try self.value("get_status", arguments: ["name_param": nameParam])
  }

  func getUsernameAndStatus(nameParam: String) throws -> _PostgrestQuery<
    GetUsernameAndStatusRow, [GetUsernameAndStatusRow]
  > {
    try self.rows("get_username_and_status", arguments: ["name_param": nameParam])
  }

  func messageById(messageId: Int) throws -> _PostgrestFunctionCall<Messages?> {
    try self.row("message_by_id", arguments: ["message_id": messageId])
  }

  func messageIds(statuses: [UserStatus]) throws -> _PostgrestFunctionCall<[Int?]> {
    try self.value("message_ids", arguments: ["statuses": statuses])
  }

  func messagesOf(channelId: Int) throws -> _PostgrestQuery<Messages, [Messages]> {
    try self.rows("messages_of", arguments: ["channel_id": channelId])
  }

  func messagesOf(channelSlug: String, maxCount: Int) throws -> _PostgrestQuery<
    Messages, [Messages]
  > {
    try self.rows("messages_of", arguments: ["channel_slug": channelSlug, "max_count": maxCount])
  }

  func searchMessages(query: String, channelId: Int? = nil) throws -> _PostgrestQuery<
    Messages, [Messages]
  > {
    try self.rows("search_messages", arguments: ["query": query, "channel_id": channelId])
  }

  func sleepFor(seconds: Double) throws -> _PostgrestFunctionCall<Void> {
    try self.perform("sleep_for", arguments: ["seconds": seconds])
  }

  func voidFunc() throws -> _PostgrestFunctionCall<Void> {
    try self.perform("void_func")
  }
}
