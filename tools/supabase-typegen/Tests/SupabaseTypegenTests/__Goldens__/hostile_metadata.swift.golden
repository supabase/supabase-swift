struct InventoryBooks {
  var id: Int
}

@Table("type")
struct TypeTable {
  var id: Int
}

@Table("user_profiles")
struct UserProfiles2 {
  var id: Int
}

@Table(#"we"ird\name"#)
struct WeIrdName {
  var id: Int
}
