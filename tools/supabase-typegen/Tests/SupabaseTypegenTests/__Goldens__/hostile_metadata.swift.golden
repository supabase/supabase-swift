import Foundation
import PostgrestMacros

enum MySchema: PostgrestSchema {
  static let name = #"my"schema"#
}

struct InventoryState: RawRepresentable, Codable, Hashable, Sendable,
  ExpressibleByStringLiteral, PostgrestFilterValue
{
  let rawValue: String
  init(rawValue: String) {
    self.rawValue = rawValue
  }
  init(stringLiteral value: String) {
    self.init(rawValue: value)
  }

  static let inStock: InventoryState = "in stock"
}

struct MySchemaStatus: RawRepresentable, Codable, Hashable, Sendable,
  ExpressibleByStringLiteral, PostgrestFilterValue
{
  let rawValue: String
  init(rawValue: String) {
    self.rawValue = rawValue
  }
  init(stringLiteral value: String) {
    self.init(rawValue: value)
  }

  static let on: MySchemaStatus = "on"
  static let off: MySchemaStatus = "off"
}

struct CodableEnum: RawRepresentable, Codable, Hashable, Sendable,
  ExpressibleByStringLiteral, PostgrestFilterValue
{
  let rawValue: String
  init(rawValue: String) {
    self.rawValue = rawValue
  }
  init(stringLiteral value: String) {
    self.init(rawValue: value)
  }

  static let a: CodableEnum = "a"
}

struct Mood: RawRepresentable, Codable, Hashable, Sendable,
  ExpressibleByStringLiteral, PostgrestFilterValue
{
  let rawValue: String
  init(rawValue: String) {
    self.rawValue = rawValue
  }
  init(stringLiteral value: String) {
    self.init(rawValue: value)
  }

  static let happy: Mood = "happy"
  static let sad: Mood = "sad"
  static let selfCase: Mood = "self"
  static let selfCase2: Mood = "Self"
  static let rawValueCase: Mood = "rawValue"
  static let initCase: Mood = "init"
  static let inProgress: Mood = "in progress"
  static let inProgress2: Mood = "in-progress"
  static let inPROGRESS: Mood = "IN_PROGRESS"
  static let _1st: Mood = "1st"
  static let `default`: Mood = "default"
  static let sayHi: Mood = #"say "hi""#
  static let backSlash: Mood = #"back\slash"#
  static let unnamed: Mood = "__"
}

struct UserProfiles3: RawRepresentable, Codable, Hashable, Sendable,
  ExpressibleByStringLiteral, PostgrestFilterValue
{
  let rawValue: String
  init(rawValue: String) {
    self.rawValue = rawValue
  }
  init(stringLiteral value: String) {
    self.init(rawValue: value)
  }

  static let a: UserProfiles3 = "a"
}

@Table("class", schema: MySchema.self)
struct MySchemaClass {
  var id: Int
}

@Table("UserProfiles")
struct UserProfiles {
  var id: Int
}

@Table("coding_keys")
struct CodingKeysTable {
  var id: Int
}

@Table("columns")
struct ColumnsTable {
  var id: Int
}

@Table("date")
struct DateTable {
  var id: Int
}

@Table("draft")
struct DraftTable {
  var id: Int
}

@Table("hostile")
struct Hostile {
  @PrimaryKey var id: Int
  @Column("class") var `class`: Int
  @Column("default") var `default`: String?
  @Column("self") var selfColumn: Bool
  @Column("Type") var type: Int
  @Column("init") var `init`: Int
  @Column("columns") var columnsColumn: Int
  @Column("select_string") var selectStringColumn: String
  @Column("relation_name") var relationNameColumn: String
  @Column("primary_key_columns") var primaryKeyColumnsColumn: String
  @Column("Draft") var draft: String
  var userId: Int
  @Column("userId") var userId2: Int
  @Column("user-id") var userId3: Int
  @Column(#"say "hi""#) var sayHi: String
  @Column(#"back\slash"#) var backSlash: String
  @Column("1st_place") var _1stPlace: Int
  @Column("__") var unnamed: String
  var rawValue: String
  var stringValue: String
  var intValue: Int
  var hashValue: Int
  var mood: Mood
  var moods: [Mood]?
  var span: JSONValue?
  var nick: String
  var ids: [UUID]?
  var price: Decimal
  var ratio: Double
  var tiny: Int
  var born: Date
  var at: Date
  var code: String
  var label: String
  var doc: JSONValue?
  var stock: InventoryState?
}

extension Hostile.Columns {
  var selfComputed: PostgrestComputedField<Hostile, String> {
    .init("Self")
  }
  var userIdComputed: PostgrestComputedField<Hostile, String> {
    .init("UserId")
  }
  var atTime: PostgrestComputedField<Hostile, Date> {
    .init("at_time")
  }
  var classes: PostgrestToManyRelation<Hostile, MySchemaClass> {
    .init("classes")
  }
  var duration: PostgrestComputedField<Hostile, JSONValue> {
    .init("duration")
  }
  var getThings: PostgrestComputedField<Hostile, Int> {
    .init("getThings")
  }
  var getThings2: PostgrestComputedField<Hostile, Int> {
    .init("get_things")
  }
  var moodsOf: PostgrestComputedField<Hostile, [Mood]> {
    .init("moods_of")
  }
  var sayHiBackSlash: PostgrestComputedField<Hostile, String> {
    .init(#"say "hi" back\slash"#)
  }
  var shouted: PostgrestComputedField<Hostile, String> {
    .init("shouted")
  }
  var tags: PostgrestComputedField<Hostile, [String]> {
    .init("tags")
  }
  var weirdMany: PostgrestToManyRelation<Hostile, WeIrdName> {
    .init("weird_many")
  }
  var weirdOne: PostgrestToOneRelation<Hostile, WeIrdName> {
    .init("weird_one")
  }
  var weirdSingle: PostgrestToOneRelation<Hostile, WeIrdName> {
    .init("weird_single")
  }
}

