import Foundation
import PostgrestMacros

enum MySchema: PostgrestSchema {
  static let name = #"my"schema"#
}

enum InventoryState: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case inStock = "in stock"
}

enum MySchemaStatus: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case on
  case off
}

enum CodableEnum: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case a
}

enum Mood: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case happy
  case sad
  case selfCase = "self"
  case selfCase2 = "Self"
  case rawValueCase = "rawValue"
  case initCase = "init"
  case inProgress = "in progress"
  case inProgress2 = "in-progress"
  case inPROGRESS = "IN_PROGRESS"
  case _1st = "1st"
  case `default`
  case sayHi = #"say "hi""#
  case backSlash = #"back\slash"#
  case unnamed = "__"
}

enum UserProfiles3: String, Codable, Hashable, Sendable, PostgrestFilterValue {
  case a
}

@Table("class", schema: MySchema.self)
struct MySchemaClass {
  var id: Int
}

@Table("UserProfiles")
struct UserProfiles {
  var id: Int
}

@Table("coding_keys")
struct CodingKeysTable {
  var id: Int
}

@Table("columns")
struct ColumnsTable {
  var id: Int
}

@Table("date")
struct DateTable {
  var id: Int
}

@Table("draft")
struct DraftTable {
  var id: Int
}

@Table("hostile")
struct Hostile {
  @PrimaryKey var id: Int
  @Column("class") var `class`: Int
  @Column("default") var `default`: String?
  @Column("self") var selfColumn: Bool
  @Column("Type") var type: Int
  @Column("init") var `init`: Int
  @Column("columns") var columnsColumn: Int
  @Column("select_string") var selectStringColumn: String
  @Column("relation_name") var relationNameColumn: String
  @Column("primary_key_columns") var primaryKeyColumnsColumn: String
  @Column("Draft") var draft: String
  var userId: Int
  @Column("userId") var userId2: Int
  @Column("user-id") var userId3: Int
  @Column(#"say "hi""#) var sayHi: String
  @Column(#"back\slash"#) var backSlash: String
  @Column("1st_place") var _1stPlace: Int
  @Column("__") var unnamed: String
  var rawValue: String
  var stringValue: String
  var intValue: Int
  var hashValue: Int
  var mood: Mood
  var moods: [Mood]?
  var span: JSONValue?
  var nick: String
  var ids: [UUID]?
  var price: Decimal
  var ratio: Double
  var tiny: Int
  var born: Date
  var at: Date
  var code: String
  var label: String
  var doc: JSONValue?
  var stock: InventoryState?
}

extension Hostile.Columns {
  var selfComputed: PostgrestComputedField<Hostile, String> {
    .init("Self")
  }
  var userIdComputed: PostgrestComputedField<Hostile, String> {
    .init("UserId")
  }
  var atTime: PostgrestComputedField<Hostile, Date> {
    .init("at_time")
  }
  var classes: PostgrestToManyRelation<Hostile, MySchemaClass> {
    .init("classes")
  }
  var duration: PostgrestComputedField<Hostile, JSONValue> {
    .init("duration")
  }
  var getThings: PostgrestComputedField<Hostile, Int> {
    .init("getThings")
  }
  var getThings2: PostgrestComputedField<Hostile, Int> {
    .init("get_things")
  }
  var moodsOf: PostgrestComputedField<Hostile, [Mood]> {
    .init("moods_of")
  }
  var sayHiBackSlash: PostgrestComputedField<Hostile, String> {
    .init(#"say "hi" back\slash"#)
  }
  var shouted: PostgrestComputedField<Hostile, String> {
    .init("shouted")
  }
  var tags: PostgrestComputedField<Hostile, [String]> {
    .init("tags")
  }
  var weirdMany: PostgrestToManyRelation<Hostile, WeIrdName> {
    .init("weird_many")
  }
  var weirdOne: PostgrestToOneRelation<Hostile, WeIrdName> {
    .init("weird_one")
  }
  var weirdSingle: PostgrestToOneRelation<Hostile, WeIrdName> {
    .init("weird_single")
  }
}

@Table("inventory_books")
struct InventoryBooks {
  var id: Int
}

@Table("type")
struct TypeTable {
  var id: Int
}

@Table("user_profiles")
struct UserProfiles2 {
  var id: Int
}

@Table(#"we"ird\name"#)
struct WeIrdName {
  var id: Int
}
